{
  "name": "zeit-overlay",
  "productName": "Zeit-Overlay",
  "version": "0.1.0",
  "description": "Durchsichtiges Timer-Overlay für die Projektzeiterfassung (ClickUp, später Projektbuch)",
  "main": "src/main.js",
  "author": "Planungsbüro Frank Czernitzki",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.js",
    "icon": "node scripts/make-icon.js",
    "dist": "electron-builder --win portable nsis"
  },
  "dependencies": {
    "uiohook-napi": "^1.5.4"
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "de.czernitzki.zeit-overlay",
    "productName": "Zeit-Overlay",
    "npmRebuild": false,
    "files": [
      "src/**/*",
      "build/icon.png",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/uiohook-napi/**"
    ],
    "win": {
      "icon": "build/icon.png",
      "target": [
        "portable",
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false
    }
  }
}
